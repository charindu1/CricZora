{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/home.jsx" },
    { "src": "/about", "dest": "/about.jsx" },
    { "src": "/predict", "dest": "/predict.jsx" },
    { "src": "/model", "dest": "/model.jsx" }
  ]
}
